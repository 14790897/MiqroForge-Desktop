{
  "name": "miqi-desktop-release",
  "version": "0.37.0-dev",
  "private": true,
  "description": "Release tooling for MiQroForge Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/14790897/MiqroForge-Desktop.git"
  },
  "scripts": {
    "commit": "cz",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/desktop/src/**/*.{ts,tsx}": "prettier --config apps/desktop/.prettierrc --ignore-path apps/desktop/.prettierignore --write",
    "apps/desktop/tests/**/*.{ts,tsx}": "prettier --config apps/desktop/.prettierrc --ignore-path apps/desktop/.prettierignore --write",
    "apps/desktop/*.{ts,mjs,cjs,js}": "prettier --config apps/desktop/.prettierrc --ignore-path apps/desktop/.prettierignore --write",
    "apps/desktop/scripts/*.{js,mjs,cjs}": "prettier --config apps/desktop/.prettierrc --ignore-path apps/desktop/.prettierignore --write",
    "apps/desktop/!(package-lock).json": "prettier --config apps/desktop/.prettierrc --ignore-path apps/desktop/.prettierignore --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
